# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=xiao
MYSQL_USERNAME=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# HTTP 与数据库并发上限（按机器规格和 MySQL max_connections 调整）
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=20
TOMCAT_ACCEPT_COUNT=200
DB_POOL_MAX_ACTIVE=64
DB_POOL_MAX_WAIT_MS=3000
# 允许访问 API 的前端 Origin，多个值用英文逗号分隔。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Flyway schema migration
FLYWAY_ENABLED=true
# Keep false. Set FLYWAY_BASELINE_ON_MIGRATE=true only for a one-time,
# pre-verified legacy schema baseline, then remove it immediately.
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# Redis 配置
REDIS_MODE=single
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=your_redis_password
# Redis logical database allocation: xiaozhaovip-intern8 = DB 4.
REDIS_DATABASE=4
CACHE_SINGLE_FLIGHT_WAIT_TIMEOUT_MS=3000

# Redis Sentinel 配置（生产环境使用）
# REDIS_MODE=sentinel
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_NODES=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
# REDIS_SENTINEL_QUORUM=2

# Redis Cluster 配置（大规模水平扩展）
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003

# 云 RabbitMQ 配置
RABBITMQ_HOST=your_cloud_rabbitmq_host
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=/intern8
RABBITMQ_ERLANG_COOKIE=your_random_cluster_cookie

# MQ compensation: isolate a blocked cloud RabbitMQ publish from the scheduler.
MQ_COMPENSATION_MAX_RUN_SECONDS=45
MQ_COMPENSATION_PER_MESSAGE_TIMEOUT_MS=5000
MQ_COMPENSATION_WORKER_THREADS=4
MQ_OUTBOX_PUBLISHER_CONFIRM_TIMEOUT_MS=5000
MQ_OUTBOX_WORKER_THREADS=4

# Docker Compose 监控面板
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# COS 对象存储配置
COS_ACCESS_KEY_ID=your_cos_access_key_id
COS_ACCESS_KEY_SECRET=your_cos_access_key_secret
COS_BUCKET=your_bucket_name
COS_HOSTNAME=https://your_bucket.cos.ap-guangzhou.myqcloud.com
COS_REGION=ap-guangzhou

# JWT 配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
# 仅本地 dev Profile 的演示登录使用；必须显式开启并限制可签发 userId。
DEMO_AUTH_ENABLED=true
DEMO_AUTH_PASSWORD=your_local_demo_password
DEMO_AUTH_ALLOWED_USER_IDS=1

# 云 Milvus（当前应用未接入，仅供连通性检查脚本使用）
MILVUS_HOST=your_cloud_milvus_host
MILVUS_PORT=19530

# 其他配置
LOGIN_TIME_KEY=your_login_time_key
SNOWFLAKE_WORKER_ID=0
