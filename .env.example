# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=xiao
MYSQL_USERNAME=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Redis 配置
REDIS_MODE=single
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=your_redis_password
CACHE_SINGLE_FLIGHT_WAIT_TIMEOUT_MS=3000

# Redis Sentinel 配置（生产环境使用）
# REDIS_MODE=sentinel
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_NODES=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
# REDIS_SENTINEL_QUORUM=2

# Redis Cluster 配置（大规模水平扩展）
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003

# 云 RabbitMQ 配置
RABBITMQ_HOST=your_cloud_rabbitmq_host
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_ERLANG_COOKIE=your_random_cluster_cookie

# Docker Compose 监控面板
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# COS 对象存储配置
COS_ACCESS_KEY_ID=your_cos_access_key_id
COS_ACCESS_KEY_SECRET=your_cos_access_key_secret
COS_BUCKET=your_bucket_name
COS_HOSTNAME=https://your_bucket.cos.ap-guangzhou.myqcloud.com
COS_REGION=ap-guangzhou

# JWT 配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# 其他配置
LOGIN_TIME_KEY=your_login_time_key
SNOWFLAKE_WORKER_ID=0
